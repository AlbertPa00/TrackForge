{
  "name": "@trackforge/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --name init",
    "db:seed": "tsx src/seed.ts",
    "backup": "tsx src/bin/backup.ts",
    "restore": "tsx src/bin/restore.ts",
    "seed:perf": "tsx src/seed-perf.ts",
    "perf:check": "tsx scripts/perf-check.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "perf:check:security": "tsx scripts/perf-check-security.ts",
    "perf:check:concurrency": "tsx scripts/perf-check-concurrency.ts",
    "import:run": "tsx scripts/run-import-job.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.15.0",
    "bullmq": "5.34.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^4.22.2",
    "fast-xml-parser": "^5.12.0",
    "file-type": "^21.3.4",
    "highlight.js": "^11.12.0",
    "ioredis": "5.10.0",
    "jsonwebtoken": "^9.0.3",
    "ldapts": "7.3.0",
    "marked": "^15",
    "multer": "^2.5.0",
    "nodemailer": "^10.5.0",
    "pino": "9.5.0",
    "prisma": "^5.15.0",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "trackforge-mcp": "workspace:*",
    "yauzl": "^3.4.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/nodemailer": "^8.0.2",
    "@types/sanitize-html": "^2.16.2",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9.0.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "5.5.4",
    "vitest": "^3.2.7"
  }
}
