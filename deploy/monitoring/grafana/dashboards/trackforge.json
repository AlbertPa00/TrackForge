{
  "title": "TrackForge — Overview",
  "uid": "trackforge-overview",
  "tags": ["trackforge"],
  "timezone": "browser",
  "refresh": "30s",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Requests / min",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "rate(tf_requests_total[5m]) * 60", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "reqpm" }, "overrides": [] },
      "options": { "graphMode": "area", "textMode": "value" }
    },
    {
      "id": 2, "type": "stat", "title": "Error rate",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "rate(tf_requests_errors_total[5m]) / rate(tf_requests_total[5m])", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "percentunit", "thresholds": { "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 0.05 }] } }, "overrides": [] },
      "options": { "textMode": "value" }
    },
    {
      "id": 3, "type": "stat", "title": "Queue waiting / failed",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        { "expr": "tf_job_queue{state=\"waiting\"}", "refId": "A", "legendFormat": "waiting" },
        { "expr": "tf_job_queue{state=\"failed\"}", "refId": "B", "legendFormat": "failed" }
      ],
      "options": { "textMode": "value_and_name" }
    },
    {
      "id": 4, "type": "stat", "title": "Backup age",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "targets": [{ "expr": "time() - tf_backup_last_success_seconds", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "s", "thresholds": { "steps": [
        { "color": "green", "value": null }, { "color": "red", "value": 93600 }] } }, "overrides": [] },
      "options": { "textMode": "value" }
    },
    {
      "id": 5, "type": "timeseries", "title": "Request latency p50 / p95",
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "targets": [
        { "expr": "histogram_quantile(0.5, rate(tf_request_latency_ms_bucket[5m]))", "refId": "A", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, rate(tf_request_latency_ms_bucket[5m]))", "refId": "B", "legendFormat": "p95" }
      ],
      "fieldConfig": { "defaults": { "unit": "ms" }, "overrides": [] }
    },
    {
      "id": 6, "type": "timeseries", "title": "Outbox undispatched",
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "targets": [{ "expr": "tf_outbox_undispatched", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    }
  ]
}
