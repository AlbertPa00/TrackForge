# TrackForge — production environment (.env). Copy, fill in, keep out of git.
# Generated from apps/backend/src/config.ts — see docs/env-reference.md.

# ── Required ──────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-postgres
SESSION_SECRET=change-me-at-least-32-characters-of-randomness
# First-run admin (used once, when zero users exist). *_FILE variants
# (e.g. TF_ADMIN_PASSWORD_FILE=/run/secrets/admin_pw) are also honored.
TF_ADMIN_EMAIL=admin@example.com
TF_ADMIN_PASSWORD=change-me-admin

# ── HTTP ──────────────────────────────────────────────────────────────
HTTP_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# S3_SECRET_KEY required when ATTACHMENT_STORAGE=s3
S3_SECRET_KEY=change-me-s3-secret

# ── Optional ──────────────────────────────────────────────────────────
# TF_TAG=latest                    # image tag to pull; 'latest' = newest build
# ATTACHMENT_STORAGE=s3            # fs (default, local dir) | s3 (MinIO)
# ATTACHMENT_DIR=/app/attachments  # host-side name for the fs volume
# S3_ENDPOINT=http://s3:9000
# S3_BUCKET=trackforge-attachments
# S3_ACCESS_KEY=trackforge
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=trackforge@example.com
# SMTP_TLS=true
# RATE_LIMIT=1000
# METRICS_BEARER=                  # bearer token required on /metrics (monitoring profile)
# UPDATE_CHECK_ENABLED=false       # opt-in: poll releases endpoint for newer versions
# UPDATE_CHECK_URL=                # default: this repo's GitHub releases/latest
# LOG_LEVEL=info
# EVENT_RETENTION_DAYS=90
# WEBHOOK_ALLOW_PRIVATE=false      # dev only — SSRF guard
# TRUST_PROXY=                     # 1 | hop count | CIDR — REQUIRED when behind a
                                  # reverse proxy or req.ip/rate-limits see the proxy
# TRACKFORGE_SECRET_REF_ALLOW=     # comma-separated env names LDAP secretRef /
                                  # GitLab apiTokenRef / import secretRef may read
                                  # (TrackForge's own secrets are refused regardless)
# AUTH_RATE_LIMIT=20               # per-minute budget on /api/internal/auth/*
# SESSION_TTL_HOURS=12             # session row + JWT lifetime; remember-me extends
