# MCP_RATE_LIMIT=6000        # /mcp mount per-IP ceiling
# TOKEN_CACHE_TTL_MS=30000   # PAT auth cache TTL (revocation is instant via invalidation)
# TOKEN_TOUCH_INTERVAL_MS=300000  # min spacing between lastUsedAt writes per token
# MCP_SERVER_POOL=32         # pooled stateless MCP server+transport pairs per toolset
